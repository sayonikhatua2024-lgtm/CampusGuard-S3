# MySQL connection (matches docker-compose.yml defaults)
MYSQL_USER=healer
MYSQL_PASSWORD=healerpass
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=self_healing_ops

# Monitoring loop tick interval, in seconds
MONITOR_INTERVAL_SECONDS=3

# Anomaly detection tuning
ANOMALY_CONTAMINATION=0.08
ANOMALY_HISTORY_WINDOW=200

# Max automated recovery attempts before an incident is escalated
MAX_RECOVERY_ATTEMPTS=2

# Auth (single seeded admin account + JWT signing secret)
JWT_SECRET_KEY=change-this-secret-in-production
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: enables Claude-authored incident explanations in the AI decision
# engine. Safe to leave unset -- the engine falls back to deterministic
# explanations and the recovery ACTION is always chosen by the rule policy,
# never by the LLM.
# ANTHROPIC_API_KEY=sk-ant-...
