# MySQL connection (matches app/config.py defaults)
MYSQL_USER=healer
MYSQL_PASSWORD=healerpass
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=self_healing_ops

# Monitoring loop interval, seconds
MONITOR_INTERVAL_SECONDS=3

# Anomaly detection
ANOMALY_CONTAMINATION=0.08
ANOMALY_HISTORY_WINDOW=200

# Recovery
MAX_RECOVERY_ATTEMPTS=2

# JWT auth (app/auth_config.py) -- CHANGE THESE BEFORE ANY REAL DEPLOYMENT
JWT_SECRET_KEY=change-this-secret-in-production
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Optional: enables Claude-generated incident explanations in decision_engine.py
# Leave unset to silently fall back to the deterministic explanation text.
ANTHROPIC_API_KEY=
