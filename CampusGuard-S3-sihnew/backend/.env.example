# Database Configuration (Managed MySQL for Production)
MYSQL_USER=healer
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=self_healing_ops
# Or direct connection string:
# DATABASE_URL=mysql+pymysql://<user>:<password>@<host>:<port>/<db>?charset=utf8mb4

# Monitoring loop tick interval, in seconds
MONITOR_INTERVAL_SECONDS=3

# Auth Configuration
# IMPORTANT: In public production, set a strong random JWT_SECRET_KEY and strong ADMIN_PASSWORD
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# CORS Deployment Control (comma-separated origins allowed to access backend)
# In production, set to your deployed frontend URL (e.g., https://campusguard.example.com)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: enables Claude-authored incident explanations in the AI decision
# engine. Safe to leave unset -- the engine falls back to deterministic
# explanations and the recovery ACTION is always chosen by the rule policy,
# never by the LLM.
# ANTHROPIC_API_KEY=

